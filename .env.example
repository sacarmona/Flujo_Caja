# Base de datos
DATABASE_URL="postgresql://flujo_caja:changeme@localhost:5432/flujo_caja?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# Zona horaria / formato regional (informativo, usado por la app)
APP_TIMEZONE="America/Santiago"
APP_LOCALE="es-CL"
APP_BASE_CURRENCY="CLP"

# Proveedor de tipos de cambio (UF, USD, EUR) — fuente de indicadores chilenos
EXCHANGE_RATE_API_URL="https://mindicador.cl/api"
EXCHANGE_RATE_API_TIMEOUT_MS="5000"

# Almacenamiento de documentos adjuntos (no usar PostgreSQL para binarios)
ATTACHMENTS_STORAGE_DRIVER="local"
ATTACHMENTS_LOCAL_PATH="./storage/attachments"
ATTACHMENTS_MAX_SIZE_MB="10"
