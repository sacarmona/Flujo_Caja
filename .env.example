DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flujo_caja?schema=public"
APP_URL="http://localhost:3000"

# Auth — pendiente de reemplazar por usuario/contraseña en la Fase B de
# consolidacion (ver docs/architecture.md). Se mantienen por ahora porque el
# codigo actual de esta rama todavia los usa.
AUTH_COOKIE_NAME="adentu_session"
AUTH_TOKEN_TTL_MINUTES="15"
SESSION_TTL_DAYS="7"

# API privada read-only para asistentes externos autorizados (ej. Jarvis).
JARVIS_API_TOKEN=""

BASE_CURRENCY="CLP"
APP_TIME_ZONE="America/Santiago"
APP_LOCALE="es-CL"
OPENING_BALANCE_CLP=""
OPENING_BALANCE_DATE="2026-01-01"

# Proveedor de tipos de cambio (UF, USD, EUR) — fuente de indicadores chilenos
EXCHANGE_RATE_API_URL="https://mindicador.cl/api"
EXCHANGE_RATE_API_TIMEOUT_MS="5000"

# Almacenamiento de documentos adjuntos (no usar PostgreSQL para binarios) —
# modelo Attachment pendiente de agregar en la Fase C de consolidacion.
ATTACHMENTS_STORAGE_DRIVER="local"
ATTACHMENTS_LOCAL_PATH="./storage/attachments"
ATTACHMENTS_MAX_SIZE_MB="10"
