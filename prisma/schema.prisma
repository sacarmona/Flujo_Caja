generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FINANCE
  MOVEMENT_ENTRY
  READ_ONLY
}

enum MovementType {
  INCOME
  EXPENSE
}

enum MovementStatus {
  PROJECTED
  PENDING
  PARTIALLY_PAID
  PAID_OR_COLLECTED
  OVERDUE
  CANCELLED
}

enum Currency {
  CLP
  UF
  EUR
  USD
}

enum AuditAction {
  CREATE
  UPDATE
  CANCEL
  SOFT_DELETE
  LOGIN
  LOGOUT
}

enum AccountingAccountType {
  INCOME
  DIRECT_COST
  ADMIN_EXPENSE
  TAX
  FINANCING
  INVESTMENT
  NON_OPERATIONAL
}

enum RecurrenceFrequency {
  DAILY
  BUSINESS_DAYS
  EVERY_N_DAYS
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

model Company {
  id           String   @id @default(cuid())
  name         String   @unique
  taxId        String?
  locale       String   @default("es-CL")
  timeZone     String   @default("America/Santiago")
  baseCurrency Currency @default(CLP)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accountingAccounts AccountingAccount[]
  auditLogs          AuditLog[]
  bankAccounts       BankAccount[]
  bankImportBatches  BankImportBatch[]
  businessUnits      BusinessUnit[]
  costCenters        CostCenter[]
  exchangeRates      ExchangeRate[]
  movements          Movement[]
  openingBalances    OpeningBalance[]
  projects           Project[]
  recurrenceRules    RecurrenceRule[]
  users              User[]
  vendors            Vendor[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(READ_ONLY)
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company                  Company           @relation(fields: [companyId], references: [id])
  auditLogs                AuditLog[]
  sessions                 Session[]
  uploadedAttachments      Attachment[]
  importBatches            BankImportBatch[]
  confirmedReconciliations Reconciliation[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BusinessUnit {
  id        String    @id @default(cuid())
  companyId String
  name      String
  code      String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  movements       Movement[]
  recurrenceRules RecurrenceRule[]
  projects        Project[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Project {
  id             String    @id @default(cuid())
  companyId      String
  businessUnitId String
  name           String
  code           String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  businessUnit    BusinessUnit     @relation(fields: [businessUnitId], references: [id])
  company         Company          @relation(fields: [companyId], references: [id])
  movements       Movement[]
  recurrenceRules RecurrenceRule[]

  @@unique([companyId, name])
  @@index([businessUnitId])
  @@index([companyId])
}

model CostCenter {
  id        String    @id @default(cuid())
  companyId String
  name      String
  code      String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  movements       Movement[]
  recurrenceRules RecurrenceRule[]

  @@unique([companyId, name])
  @@index([companyId])
}

model AccountingAccount {
  id             String                @id @default(cuid())
  companyId      String
  parentId       String?
  code           String
  name           String
  type           AccountingAccountType
  sortOrder      Int                   @default(0)
  level          Int                   @default(1)
  isActive       Boolean               @default(true)
  allowMovements Boolean               @default(true)
  deletedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  children        AccountingAccount[] @relation("AccountingAccountHierarchy")
  company         Company             @relation(fields: [companyId], references: [id])
  movements       Movement[]
  recurrenceRules RecurrenceRule[]
  parent          AccountingAccount?  @relation("AccountingAccountHierarchy", fields: [parentId], references: [id])

  @@unique([companyId, code])
  @@index([companyId])
  @@index([parentId])
}

model BankAccount {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  bankName      String
  accountNumber String?
  currency      Currency  @default(CLP)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company           Company           @relation(fields: [companyId], references: [id])
  movements         Movement[]
  openingBalances   OpeningBalance[]
  payments          Payment[]
  recurrenceRules   RecurrenceRule[]
  bankImportBatches BankImportBatch[]
  bankMovements     BankMovement[]

  @@unique([companyId, name])
  @@index([companyId])
}

model OpeningBalance {
  id            String    @id @default(cuid())
  companyId     String
  bankAccountId String
  amount        Decimal   @db.Decimal(14, 2)
  currency      Currency  @default(CLP)
  balanceDate   DateTime
  note          String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])

  @@unique([bankAccountId, balanceDate])
  @@index([companyId])
  @@index([bankAccountId])
}

model Movement {
  id                       String         @id @default(cuid())
  companyId                String
  recurrenceRuleId         String?
  recurrenceOccurrenceDate DateTime?
  businessUnitId           String
  accountingAccountId      String
  bankAccountId            String
  projectId                String?
  costCenterId             String?
  vendorId                 String?
  type                     MovementType
  status                   MovementStatus @default(PROJECTED)
  description              String
  amount                   Decimal        @db.Decimal(14, 2)
  currency                 Currency       @default(CLP)
  conversionDate           DateTime
  projectedRate            Decimal        @default(1) @db.Decimal(18, 6)
  projectedAmountClp       Decimal        @db.Decimal(14, 2)
  exchangeRateSource       String         @default("CLP")
  isManualRate             Boolean        @default(false)
  manualRateReason         String?
  projectedDate            DateTime
  realDate                 DateTime?
  notes                    String?
  cancelledAt              DateTime?
  deletedAt                DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  accountingAccount AccountingAccount @relation(fields: [accountingAccountId], references: [id])
  bankAccount       BankAccount       @relation(fields: [bankAccountId], references: [id])
  businessUnit      BusinessUnit      @relation(fields: [businessUnitId], references: [id])
  company           Company           @relation(fields: [companyId], references: [id])
  costCenter        CostCenter?       @relation(fields: [costCenterId], references: [id])
  vendor            Vendor?           @relation(fields: [vendorId], references: [id])
  payments          Payment[]
  project           Project?          @relation(fields: [projectId], references: [id])
  recurrenceRule    RecurrenceRule?   @relation(fields: [recurrenceRuleId], references: [id])
  attachments       Attachment[]
  reconciliations   Reconciliation[]

  @@unique([recurrenceRuleId, recurrenceOccurrenceDate])
  @@index([accountingAccountId])
  @@index([bankAccountId])
  @@index([businessUnitId])
  @@index([companyId, projectedDate])
  @@index([costCenterId])
  @@index([projectId])
  @@index([recurrenceRuleId])
  @@index([vendorId])
}

model RecurrenceRule {
  id                  String              @id @default(cuid())
  companyId           String
  businessUnitId      String
  accountingAccountId String
  bankAccountId       String
  projectId           String?
  costCenterId        String?
  vendorId            String?
  type                MovementType
  description         String
  amount              Decimal             @db.Decimal(14, 2)
  currency            Currency            @default(CLP)
  manualRate          Decimal?            @db.Decimal(18, 6)
  manualRateReason    String?
  frequency           RecurrenceFrequency
  intervalDays        Int?
  dayOfMonth          Int?
  dayOfWeek           Int?
  startDate           DateTime
  endDate             DateTime?
  status              MovementStatus      @default(PROJECTED)
  notes               String?
  isActive            Boolean             @default(true)
  deactivatedAt       DateTime?
  nextEditScope       String              @default("THIS_OCCURRENCE")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  accountingAccount AccountingAccount @relation(fields: [accountingAccountId], references: [id])
  bankAccount       BankAccount       @relation(fields: [bankAccountId], references: [id])
  businessUnit      BusinessUnit      @relation(fields: [businessUnitId], references: [id])
  company           Company           @relation(fields: [companyId], references: [id])
  costCenter        CostCenter?       @relation(fields: [costCenterId], references: [id])
  vendor            Vendor?           @relation(fields: [vendorId], references: [id])
  movements         Movement[]
  project           Project?          @relation(fields: [projectId], references: [id])

  @@index([accountingAccountId])
  @@index([bankAccountId])
  @@index([businessUnitId])
  @@index([companyId, startDate])
  @@index([costCenterId])
  @@index([projectId])
  @@index([vendorId])
}

/// Proveedor con deuda historica que se va abonando a traves de movimientos
/// de Egreso (Pago). initialDebtClp es el monto Total adeudado al momento de
/// cargar el proveedor (editable manualmente); el saldo pendiente (y si esta
/// liquidado o sobrepagado) se calcula en cada lectura restando lo
/// efectivamente pagado (Movement.payments de movimientos vinculados, igual
/// criterio que Modo Real: Parcial + Pagado/Cobrado) - no se guarda como
/// columna para que siempre quede consistente con los pagos reales sin
/// depender de que cada punto de registro de pago lo actualice.
model Vendor {
  id                   String    @id @default(cuid())
  companyId            String
  category             String
  name                 String
  referenceInstallment Decimal?  @db.Decimal(14, 2)
  dueDay               Int?
  initialDebtClp       Decimal   @db.Decimal(14, 2)
  notes                String?
  isActive             Boolean   @default(true)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  movements       Movement[]
  recurrenceRules RecurrenceRule[]

  @@index([companyId])
}

model Payment {
  id            String    @id @default(cuid())
  movementId    String
  bankAccountId String
  amount        Decimal   @db.Decimal(14, 2)
  currency      Currency  @default(CLP)
  paidAt        DateTime
  reference     String?
  cancelledAt   DateTime?
  cancelReason  String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bankAccount    BankAccount     @relation(fields: [bankAccountId], references: [id])
  movement       Movement        @relation(fields: [movementId], references: [id])
  attachments    Attachment[]
  reconciliation Reconciliation?

  @@index([bankAccountId])
  @@index([movementId])
}

model ExchangeRate {
  id           String    @id @default(cuid())
  companyId    String
  fromCurrency Currency
  toCurrency   Currency
  rate         Decimal   @db.Decimal(18, 6)
  rateDate     DateTime
  source       String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, fromCurrency, toCurrency, rateDate])
  @@index([companyId])
}

model AuditLog {
  id        String      @id @default(cuid())
  companyId String
  userId    String?
  entity    String
  entityId  String
  action    AuditAction
  before    Json?
  after     Json?
  metadata  Json?
  createdAt DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, entity, entityId])
  @@index([userId])
}

/// Dias no laborables (feriados oficiales chilenos cargados por seed mas
/// dias especiales agregados manualmente por ADMIN). Se mantiene una copia
/// local en base de datos en vez de consultar una fuente externa en cada
/// calculo, para que los calculos historicos no cambien inesperadamente.
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  isManual  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([date])
}

model Attachment {
  id           String    @id @default(cuid())
  movementId   String?
  paymentId    String?
  originalName String
  storageKey   String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?

  movement   Movement? @relation(fields: [movementId], references: [id])
  payment    Payment?  @relation(fields: [paymentId], references: [id])
  uploadedBy User      @relation(fields: [uploadedById], references: [id])

  @@index([movementId])
  @@index([paymentId])
}

enum ImportBatchStatus {
  UPLOADED
  MAPPED
  PROCESSED
  FAILED
}

model BankImportBatch {
  id            String            @id @default(cuid())
  companyId     String
  bankAccountId String
  fileName      String
  status        ImportBatchStatus @default(UPLOADED)
  uploadedById  String
  uploadedAt    DateTime          @default(now())

  company       Company         @relation(fields: [companyId], references: [id])
  bankAccount   BankAccount     @relation(fields: [bankAccountId], references: [id])
  uploadedBy    User            @relation(fields: [uploadedById], references: [id])
  rows          BankImportRow[]
  bankMovements BankMovement[]

  @@index([companyId])
  @@index([bankAccountId])
}

model BankImportRow {
  id             String   @id @default(cuid())
  batchId        String
  rowNumber      Int
  rawData        Json
  normalizedData Json?
  error          String?
  createdAt      DateTime @default(now())

  batch BankImportBatch @relation(fields: [batchId], references: [id])

  @@index([batchId])
}

enum BankMovementType {
  CARGO
  ABONO
}

model BankMovement {
  id                    String           @id @default(cuid())
  batchId               String
  bankAccountId         String
  date                  DateTime
  amount                Decimal          @db.Decimal(14, 2)
  type                  BankMovementType
  description           String
  normalizedDescription String?
  reference             String?
  createdAt             DateTime         @default(now())

  batch          BankImportBatch @relation(fields: [batchId], references: [id])
  bankAccount    BankAccount     @relation(fields: [bankAccountId], references: [id])
  reconciliation Reconciliation?

  @@index([batchId])
  @@index([bankAccountId])
}

enum ReconciliationMatchLevel {
  HIGH
  POSSIBLE
  NONE
}

model Reconciliation {
  id             String                   @id @default(cuid())
  bankMovementId String                   @unique
  movementId     String?
  paymentId      String?                  @unique
  matchLevel     ReconciliationMatchLevel
  confirmed      Boolean                  @default(false)
  confirmedById  String?
  confirmedAt    DateTime?
  reversed       Boolean                  @default(false)
  reversedAt     DateTime?
  reversalReason String?
  createdAt      DateTime                 @default(now())

  bankMovement BankMovement @relation(fields: [bankMovementId], references: [id])
  movement     Movement?    @relation(fields: [movementId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])
  confirmedBy  User?        @relation(fields: [confirmedById], references: [id])

  @@index([movementId])
}
